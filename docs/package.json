{
	"name": "@viamrobotics/prime-docs",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "wireit",
		"preview": "astro preview",
		"check": "wireit",
		"lint": "wireit",
		"lint:fix": "eslint . --fix --concurrency auto",
		"test:unit": "vitest",
		"test": "wireit"
	},
	"wireit": {
		"check": {
			"command": "astro sync && svelte-check --tsconfig ./tsconfig.json",
			"dependencies": [
				"../packages/prime-ui:package",
				"../packages/prime-panes:package",
				"../packages/prime-tree:package",
				"../packages/tweakpane-config:package"
			],
			"files": [
				"src/**",
				"tsconfig.json",
				"astro.config.mjs",
				"source-aliases.mjs",
				"package.json",
				"../packages/prime-ui/dist/**",
				"../packages/prime-panes/dist/**",
				"../packages/prime-tree/dist/**",
				"../packages/tweakpane-config/dist/**"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"lint": {
			"command": "eslint . --concurrency auto",
			"files": [
				"src/**/*.astro",
				"eslint.config.js",
				"tsconfig.json",
				"package.json"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"build": {
			"command": "astro build",
			"dependencies": [
				"../packages/prime-ui:package",
				"../packages/prime-panes:package",
				"../packages/prime-tree:package",
				"../packages/tweakpane-config:package"
			],
			"files": [
				"src/**",
				"public/**",
				"astro.config.mjs",
				"source-aliases.mjs",
				"tsconfig.json",
				"package.json",
				"../packages/prime-ui/dist/**",
				"../packages/prime-ui/src/lib/**",
				"../packages/prime-panes/dist/**",
				"../packages/prime-panes/src/lib/**",
				"../packages/prime-tree/dist/**",
				"../packages/prime-tree/src/lib/**",
				"../packages/tweakpane-config/dist/**",
				"../packages/tailwind-config/tailwind-config.css",
				"../packages/tailwind-config/tailwind-config-dark.css"
			],
			"output": [
				"dist/**",
				".astro/**"
			],
			"env": {
				"DOCS_BASE": {
					"external": true
				},
				"DOCS_SITE": {
					"external": true
				}
			},
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"test": {
			"command": "vitest run --passWithNoTests",
			"files": [
				"src/**",
				"vitest.config.ts",
				"source-aliases.mjs",
				"tsconfig.json",
				"package.json",
				"../packages/prime-ui/src/lib/**",
				"../packages/prime-panes/src/lib/**",
				"../packages/prime-tree/src/lib/**",
				"../packages/tweakpane-config/src/lib/**",
				"../packages/tailwind-config/tailwind-config.css",
				"../packages/tailwind-config/tailwind-config-dark.css"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		}
	},
	"dependencies": {
		"@astrojs/starlight": "0.42.11",
		"@tailwindcss/vite": "catalog:",
		"astro": "7.4.11",
		"sharp": "0.34.2",
		"starlight-theme-nova": "0.12.3",
		"tailwindcss": "catalog:"
	},
	"devDependencies": {
		"@astrojs/svelte": "^9.1.5",
		"@eslint/compat": "catalog:",
		"@fontsource-variable/public-sans": "catalog:",
		"@fontsource-variable/roboto-mono": "catalog:",
		"@lucide/svelte": "^1.17.0",
		"@mdi/js": "^7.4.47",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@viamrobotics/prime-panes": "workspace:^",
		"@viamrobotics/prime-tree": "workspace:^",
		"@viamrobotics/prime-ui": "workspace:^",
		"@viamrobotics/tailwind-config": "workspace:^",
		"@viamrobotics/tweakpane-config": "workspace:^",
		"@vitest/browser-playwright": "^4.1.3",
		"@zag-js/floating-panel": "1.46.0",
		"@zag-js/splitter": "1.46.0",
		"@zag-js/svelte": "1.46.0",
		"@zag-js/tree-view": "1.46.0",
		"astro-eslint-parser": "^3.2.0",
		"eslint": "catalog:",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"playwright": "^1.65.0",
		"svelte": "^5.55.5",
		"svelte-check": "catalog:",
		"svelte-tweakpane-ui": "^1.5.16",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0",
		"wireit": "catalog:"
	}
}
