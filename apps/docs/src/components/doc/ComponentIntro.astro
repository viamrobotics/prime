---
/**
 * The component's `@component` doc block, rendered from package source.
 * `name` is the collection id: a root like `select`, or a part like `select/trigger`.
 * `collection` is the package's component collection, `prime-ui` by default.
 */
import { getEntry, render } from "astro:content";

import type { ComponentCollection } from "./collection";

interface Props {
  name: string;
  collection?: ComponentCollection;
}

const { name, collection = "prime-ui" } = Astro.props;
const entry = await getEntry(collection, name);
if (!entry) throw new Error(`No ${collection} component entry "${name}"`);
const { Content } = await render(entry);
---

<Content />
