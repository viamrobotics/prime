---
/**
 * A live example with its source underneath. Put the Svelte island in the default slot
 * and pass the island file's text as `code` (import it with `?raw`), so the source a
 * reader copies is the exact file rendering above it.
 */
import { Code } from "@astrojs/starlight/components";

interface Props {
  code: string;
  /** Filename shown on the code block. */
  title?: string;
  /**
   * A fixed height for the preview, as a CSS length, for a demo that fills its box
   * instead of sizing to its content, such as a pane layout or a tree. The island
   * gets the full height to lay out in.
   */
  height?: string;
}

const { code, title, height } = Astro.props;
---

<figure class="example">
  <div class="example-preview not-content" style={height && `height: ${height}`}>
    <slot />
  </div>
  <details class="example-source">
    <summary>Code</summary>
    <Code code={code} lang="svelte" title={title} />
  </details>
</figure>

<style>
  .example {
    margin: 0;
    margin-top: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .example-preview {
    padding: 2rem;
    background: var(--sl-color-bg);
  }
  .example-preview[style] {
    display: flex;
    flex-direction: column;
    overflow: auto;
  }
  .example-preview[style] > :global(*) {
    flex: 1;
    min-height: 0;
  }
  .example-source {
    border-top: 1px solid var(--sl-color-gray-5);
  }
  .example-source summary {
    cursor: pointer;
    padding: 0.5rem 1rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    user-select: none;
  }
  .example-source :global(.expressive-code) {
    margin: 0;
  }
  .example-source :global(.expressive-code .frame) {
    border-radius: 0;
    box-shadow: none;
  }
</style>
