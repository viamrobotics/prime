{
	"name": "@viamrobotics/prime-docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"build": "wireit",
		"build:playgrounds": "wireit",
		"preview": "astro preview",
		"test:unit": "vitest",
		"test": "wireit"
	},
	"wireit": {
		"build:playgrounds": {
			"command": "node scripts/build-playgrounds.mjs",
			"dependencies": [
				"../../packages/tailwind-config:build",
				"../../packages/tweakpane-config:vite-build"
			],
			"files": [
				"scripts/build-playgrounds.mjs",
				"../../packages/tailwind-config/build/**",
				"../../packages/tweakpane-config/build/**"
			],
			"output": [
				"public/playground/**"
			],
			"env": {
				"DOCS_BASE": {
					"external": true
				}
			},
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"build": {
			"command": "astro build",
			"dependencies": [
				"build:playgrounds",
				"../../packages/prime-ui:package"
			],
			"files": [
				"src/**",
				"public/**",
				"astro.config.mjs",
				"tsconfig.json",
				"package.json",
				"../../packages/prime-ui/dist/**",
				"../../packages/prime-ui/src/lib/**"
			],
			"output": [
				"dist/**",
				".astro/**"
			],
			"env": {
				"DOCS_BASE": {
					"external": true
				},
				"DOCS_SITE": {
					"external": true
				}
			},
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"test": {
			"command": "vitest run --passWithNoTests",
			"files": [
				"src/**",
				"vitest.config.ts",
				"tsconfig.json",
				"package.json",
				"../../packages/prime-ui/src/lib/**"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		}
	},
	"dependencies": {
		"@astrojs/starlight": "0.38.4",
		"@tailwindcss/vite": "catalog:",
		"astro": "6.2.0",
		"sharp": "0.34.2",
		"starlight-theme-nova": "0.11.9",
		"tailwindcss": "catalog:"
	},
	"devDependencies": {
		"@astrojs/svelte": "^8.1.2",
		"@fontsource-variable/public-sans": "catalog:",
		"@lucide/svelte": "^1.17.0",
		"@fontsource-variable/roboto-mono": "catalog:",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@viamrobotics/prime-ui": "workspace:^",
		"@viamrobotics/tailwind-config": "workspace:^",
		"@vitest/browser-playwright": "^4.1.3",
		"playwright": "^1.59.1",
		"svelte": "^5.55.5",
		"typescript": "^5.9.2",
		"vite": "^7.3.0",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0",
		"wireit": "catalog:"
	}
}
