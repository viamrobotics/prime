{
  "$schema": "../node_modules/@houserules/cli/schema/houserules.config.schema.json",
  "version": 2,
  "packageManager": "pnpm",
  "plugins": [
    {
      "name": "@houserules/plugin-prose",
      "alias": "prose"
    },
    {
      "name": "@houserules/plugin-typescript",
      "alias": "ts"
    },
    {
      "name": "@houserules/plugin-svelte",
      "alias": "svelte"
    },
    {
      "name": "@houserules/plugin-testing",
      "alias": "testing"
    },
    {
      "name": "@houserules/plugin-changesets",
      "alias": "changesets"
    },
    {
      "name": "@houserules/plugin-design",
      "alias": "design"
    },
    {
      "name": "@houserules/plugin-accessibility",
      "alias": "accessibility"
    }
  ],
  "fix": {
    "runner": "pnpm",
    "filterFlag": "--filter",
    "runScriptPrefix": [
      "run"
    ],
    "commands": [
      "lint:fix",
      "format:fix"
    ],
    "onSubagentStop": false
  },
  "verify": {
    "runner": "pnpm",
    "filterFlag": "--filter",
    "runScriptPrefix": [
      "run"
    ],
    "commands": [
      "check",
      "lint",
      "format",
      "test"
    ]
  },
  "lintableExtensions": [
    "ts",
    "tsx",
    "js",
    "jsx",
    "mjs",
    "cjs",
    "svelte",
    "astro",
    "md",
    "json",
    "css",
    "html"
  ],
  "generatedFilePattern": "/CHANGELOG\\.md$",
  "guard": {
    "gitCommit": true,
    "gitPush": true,
    "gitStash": true,
    "prCreate": true,
    "custom": []
  },
  "changesets": {
    "enabled": true,
    "stopCheck": true,
    "baseBranch": "main"
  },
  "ledger": {
    "enabled": false
  },
  "design": {
    "themeEntry": "packages/prime-ui/tailwind.css"
  },
  "orchestrate": {
    "workerTools": ["mcp__svelte__svelte-autofixer"]
  },
  "targets": [
    {
      "name": "prime-ui",
      "prefix": "PRIME_UI",
      "packageName": "@viamrobotics/prime-ui",
      "pathPrefix": "packages/prime-ui/",
      "sourcePath": "packages/prime-ui/src",
      "label": "Prime UI",
      "fixCommands": [
        "lint:fix",
        "format:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "format",
        "test"
      ]
    },
    {
      "name": "tailwind-config",
      "prefix": "TAILWIND_CONFIG",
      "packageName": "@viamrobotics/tailwind-config",
      "pathPrefix": "packages/tailwind-config/",
      "sourcePath": "packages/tailwind-config",
      "label": "Tailwind Config",
      "fixCommands": [
        "lint:fix",
        "format:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "format",
        "test"
      ]
    },
    {
      "name": "tweakpane-config",
      "prefix": "TWEAKPANE_CONFIG",
      "packageName": "@viamrobotics/tweakpane-config",
      "pathPrefix": "packages/tweakpane-config/",
      "sourcePath": "packages/tweakpane-config/src",
      "label": "Tweakpane Config",
      "fixCommands": [
        "lint:fix",
        "format:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "format"
      ]
    },
    {
      "name": "prime-panes",
      "prefix": "PRIME_SPLIT_VIEW",
      "packageName": "@viamrobotics/prime-panes",
      "pathPrefix": "packages/prime-panes/",
      "sourcePath": "packages/prime-panes/src",
      "label": "Prime Panes",
      "fixCommands": [
        "lint:fix",
        "format:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "format",
        "test"
      ]
    },
    {
      "name": "prime-tree",
      "prefix": "PRIME_TREE",
      "packageName": "@viamrobotics/prime-tree",
      "pathPrefix": "packages/prime-tree/",
      "sourcePath": "packages/prime-tree/src",
      "label": "Prime Tree",
      "fixCommands": [
        "lint:fix",
        "format:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "format",
        "test"
      ]
    },
    {
      "name": "prime-controls",
      "prefix": "PRIME_CONTROLS",
      "packageName": "@viamrobotics/prime-controls",
      "pathPrefix": "packages/prime-controls/",
      "sourcePath": "packages/prime-controls/src",
      "label": "Prime Controls",
      "fixCommands": [
        "lint:fix",
        "format:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "format",
        "test"
      ]
    },
    {
      "name": "prime-editor",
      "prefix": "PRIME_EDITOR",
      "packageName": "@viamrobotics/prime-editor",
      "pathPrefix": "packages/prime-editor/",
      "sourcePath": "packages/prime-editor/src",
      "label": "Prime Editor",
      "fixCommands": [
        "lint:fix",
        "format:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "format",
        "test"
      ]
    },
    {
      "name": "docs",
      "prefix": "DOCS",
      "packageName": "@viamrobotics/prime-docs",
      "pathPrefix": "docs/",
      "sourcePath": "docs/src",
      "label": "Docs",
      "fixCommands": [
        "lint:fix"
      ],
      "verifyCommands": [
        "check",
        "lint",
        "test",
        "build"
      ]
    }
  ],
  "moduleOptions": {
    "orchestrate": [],
    "svelte/svelte": [],
    "testing/testing": [
      "typescript",
      "svelte"
    ],
    "accessibility/accessibility": [
      "html",
      "svelte"
    ]
  }
}
