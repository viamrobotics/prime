{
  "name": "@viamrobotics/prime-repo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "http://viamrobotics.github.io/prime",
  "repository": "git://github.com/viamrobotics/prime.git",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm -C docs dev",
    "build": "wireit",
    "check": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "format": "wireit",
    "lint:fix": "pnpm -r run --if-present lint:fix",
    "format:fix": "pnpm -r run --if-present format:fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./packages/prime-ui:build",
        "./packages/prime-panes:build",
        "./packages/prime-tree:build",
        "./packages/tweakpane-config:build",
        "./docs:build"
      ]
    },
    "check": {
      "dependencies": [
        "./packages/tailwind-config:check",
        "./packages/prime-ui:check",
        "./packages/prime-panes:check",
        "./packages/prime-tree:check",
        "./packages/tweakpane-config:check",
        "./docs:check"
      ]
    },
    "lint": {
      "dependencies": [
        "./packages/tailwind-config:lint",
        "./packages/prime-ui:lint",
        "./packages/prime-panes:lint",
        "./packages/prime-tree:lint",
        "./packages/tweakpane-config:lint",
        "./docs:lint"
      ]
    },
    "test": {
      "dependencies": [
        "./packages/tailwind-config:test",
        "./packages/prime-ui:test",
        "./packages/prime-panes:test",
        "./packages/prime-tree:test",
        "./docs:test"
      ]
    },
    "format": {
      "dependencies": [
        "./packages/tailwind-config:format",
        "./packages/prime-ui:format",
        "./packages/prime-panes:format",
        "./packages/prime-tree:format",
        "./packages/tweakpane-config:format"
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@houserules/cli": "^0.12.1",
    "@houserules/plugin-accessibility": "^0.2.1",
    "@houserules/plugin-changesets": "^0.3.2",
    "@houserules/plugin-design": "^0.4.2",
    "@houserules/plugin-prose": "^0.2.2",
    "@houserules/plugin-svelte": "^0.2.0",
    "@houserules/plugin-testing": "^0.3.3",
    "@houserules/plugin-typescript": "^0.1.3",
    "@tailwindcss/oxide": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wireit": "catalog:"
  }
}
