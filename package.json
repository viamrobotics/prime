{
  "name": "@viamrobotics/prime-repo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "http://viamrobotics.github.io/prime",
  "repository": "git://github.com/viamrobotics/prime.git",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "app:docs": "pnpm --filter @viamrobotics/prime-docs dev",
    "build": "wireit",
    "check": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "format": "wireit",
    "lint:fix": "pnpm -r run --if-present lint:fix",
    "format:fix": "pnpm -r run --if-present format:fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./packages/tailwind-config:build",
        "./packages/prime-ui:build",
        "./packages/tweakpane-config:build",
        "./apps/docs:build"
      ]
    },
    "check": {
      "dependencies": [
        "./packages/tailwind-config:check",
        "./packages/prime-ui:check",
        "./packages/tweakpane-config:check"
      ]
    },
    "lint": {
      "dependencies": [
        "./packages/tailwind-config:lint",
        "./packages/prime-ui:lint",
        "./packages/tweakpane-config:lint"
      ]
    },
    "test": {
      "dependencies": [
        "./packages/prime-ui:test"
      ]
    },
    "format": {
      "dependencies": [
        "./packages/tailwind-config:format",
        "./packages/prime-ui:format",
        "./packages/tweakpane-config:format"
      ]
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@houserules/cli": "^0.6.1",
    "@houserules/plugin-accessibility": "^0.1.4",
    "@houserules/plugin-changesets": "^0.2.4",
    "@houserules/plugin-design": "^0.2.3",
    "@houserules/plugin-prose": "^0.2.0",
    "@houserules/plugin-svelte": "^0.1.2",
    "@houserules/plugin-testing": "^0.3.1",
    "@houserules/plugin-typescript": "^0.1.2",
    "@tailwindcss/oxide": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wireit": "catalog:"
  }
}
