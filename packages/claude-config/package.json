{
  "name": "@viamrobotics/claude-config",
  "version": "0.0.0",
  "description": "CLI that installs, updates, and doctors Viam's shared Claude agent tooling across repos.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamrobotics/prime.git",
    "directory": "packages/claude-config"
  },
  "type": "module",
  "bin": {
    "claude-config": "./dist/cli.js"
  },
  "exports": {
    "./schema": "./schema/manifest.schema.json"
  },
  "files": [
    "dist",
    "templates",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "wireit",
    "package": "wireit",
    "prepack": "wireit",
    "check": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "package"
      ]
    },
    "package": {
      "command": "tsc -p tsconfig.build.json && publint",
      "files": [
        "src/**",
        "templates/**",
        "schema/**",
        "tsconfig.build.json",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**"
      ],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "prepack": {
      "dependencies": [
        "package"
      ]
    },
    "check": {
      "command": "tsc --noEmit -p tsconfig.json",
      "files": [
        "src/**",
        "test/**",
        "tsconfig.json",
        "tsconfig.build.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "lint": {
      "command": "eslint . --concurrency auto",
      "files": [
        "**/*.{js,mjs,cjs,ts}",
        "!dist/**",
        "!.wireit/**",
        "eslint.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "test": {
      "command": "vitest run --passWithNoTests",
      "files": [
        "src/**",
        "test/**",
        "templates/**",
        "schema/**",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "viam",
    "claude",
    "cli",
    "config"
  ]
}
