      "Edit(file_path=dist/**)",
      "Write(file_path=dist/**)",
      "Edit(file_path=.changeset/**)"
    ]
  }
}


--- .mcp.json (full, mcp) ---
{
  "mcpServers": {
    "svelte": {
      "type": "stdio",
      "command": "npx",
      "env": {},
      "args": ["-y", "@sveltejs/mcp"]
    }
