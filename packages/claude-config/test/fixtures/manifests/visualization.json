{
  "repo": {
    "name": "visualization",
    "monorepo": false,
    "packageManager": "pnpm",
    "nodeVersion": "22",
    "packageScope": "@viamrobotics",
    "workspaceRootPackage": "@viamrobotics/motion-tools",
    "wireit": true
  },
  "rules": {
    "modules": {
      "svelte": true,
      "frontendAesthetics": true,
      "three": true,
      "typescript": false,
      "testingFrontend": true,
      "changesets": true,
      "prDescription": true,
      "go": true,
      "testingGo": true
    }
  },
  "mcp": { "svelteTransport": "none", "vscode": false },
  "outputStyle": { "terse": "default" },
  "hooks": { "sessionStart": true },
  "ci": { "setupAction": true, "weeklyDependencyUpdate": false },
  "verify": {
    "lint": "pnpm lint",
    "check": "pnpm check",
    "test": "pnpm test",
    "build": "pnpm build"
  },
  "workflows": {
    "teamMention": "@viamrobotics/team-viz",
    "goTools": true,
    "secrets": {
      "slackAlertWebhook": true,
      "gitAccessToken": true,
      "githubApp": true,
      "jira": false
    }
  }
}
