{
	"name": "@viamrobotics/prime-ui",
	"version": "0.0.1",
	"description": "Viam's Svelte 5 component library.",
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/viamrobotics/prime.git",
		"directory": "packages/prime-ui"
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./icons": {
			"types": "./dist/icons/index.d.ts",
			"svelte": "./dist/icons/index.js"
		},
		"./styles.css": "./styles.css"
	},
	"files": [
		"dist",
		"styles.css",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/__tests__/**"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"prepare": "pnpm run sync || echo ''",
		"sync": "wireit",
		"build": "wireit",
		"package": "wireit",
		"prepack": "wireit",
		"check": "wireit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "wireit",
		"lint:fix": "eslint . --fix --concurrency auto",
		"format": "wireit",
		"format:fix": "prettier --write .",
		"test:unit": "vitest",
		"test": "wireit"
	},
	"wireit": {
		"sync": {
			"command": "svelte-kit sync",
			"files": [
				"svelte.config.js",
				"tsconfig.json",
				"src/**",
				"package.json"
			],
			"output": [
				".svelte-kit/generated/**",
				".svelte-kit/types/**",
				".svelte-kit/ambient.d.ts",
				".svelte-kit/non-ambient.d.ts",
				".svelte-kit/tsconfig.json"
			],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"build": {
			"dependencies": [
				"package"
			]
		},
		"package": {
			"command": "svelte-package && publint",
			"dependencies": [
				"sync"
			],
			"files": [
				"src/lib/**",
				"svelte.config.js",
				"tsconfig.json",
				"package.json"
			],
			"output": [
				"dist/**"
			],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"prepack": {
			"dependencies": [
				"package"
			]
		},
		"check": {
			"command": "svelte-check --tsconfig ./tsconfig.json",
			"dependencies": [
				"sync"
			],
			"files": [
				"src/**",
				"tsconfig.json",
				"svelte.config.js",
				"package.json",
				"../tailwind-config/tailwind-config.css",
				"../tailwind-config/tailwind-config-dark.css"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"test": {
			"command": "vitest run --passWithNoTests",
			"dependencies": [
				"sync"
			],
			"files": [
				"src/**",
				"vite.config.ts",
				"tsconfig.json",
				"svelte.config.js",
				"package.json",
				"../tailwind-config/tailwind-config.css"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"lint": {
			"command": "eslint . --concurrency auto",
			"dependencies": [
				"sync"
			],
			"files": [
				"**/*.{js,mjs,cjs,ts,svelte}",
				"!build/**",
				"!dist/**",
				"!.svelte-kit/**",
				"!.wireit/**",
				"eslint.config.js",
				"tsconfig.json",
				"package.json",
				"../tailwind-config/tailwind-config.css"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"format": {
			"command": "prettier --check .",
			"files": [
				"**",
				"!build/**",
				"!dist/**",
				"!.svelte-kit/**",
				"!.wireit/**"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		}
	},
	"dependencies": {
		"@internationalized/date": "^3.12.2",
		"@mdi/js": "^7.4.47",
		"@viamrobotics/tailwind-config": "workspace:^",
		"bits-ui": "^2.18.1"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "catalog:",
		"@eslint/js": "catalog:",
		"@lucide/svelte": "^1.17.0",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@vitest/browser-playwright": "^4.1.3",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-perfectionist": "^5.10.0",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"playwright": "^1.59.1",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"type-fest": "^5.8.0",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"keywords": [
		"svelte"
	]
}
