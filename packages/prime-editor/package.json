{
	"name": "@viamrobotics/prime-editor",
	"version": "0.0.0",
	"description": "A CodeMirror 6 code editor for Svelte 5, themed with Viam's code tokens, with a diff view.",
	"license": "Apache-2.0",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/viamrobotics/prime.git",
		"directory": "packages/prime-editor"
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./styles.css"
	},
	"files": [
		"dist",
		"styles.css",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/__tests__/**"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "wireit",
		"package": "wireit",
		"prepack": "wireit",
		"check": "wireit",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "wireit",
		"lint:fix": "eslint . --fix --concurrency auto",
		"format": "wireit",
		"format:fix": "prettier --write .",
		"test:unit": "vitest",
		"test": "wireit"
	},
	"wireit": {
		"build": {
			"dependencies": [
				"package"
			]
		},
		"package": {
			"command": "svelte-package --tsconfig ./tsconfig.package.json && publint",
			"files": [
				"src/lib/**",
				"svelte.config.js",
				"tsconfig.json",
				"tsconfig.package.json",
				"package.json"
			],
			"output": [
				"dist/**"
			],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"prepack": {
			"dependencies": [
				"package"
			]
		},
		"check": {
			"command": "svelte-check --tsconfig ./tsconfig.json",
			"files": [
				"src/**",
				"test/**",
				"tsconfig.json",
				"svelte.config.js",
				"package.json"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"test": {
			"command": "vitest run --passWithNoTests",
			"files": [
				"src/**",
				"test/**",
				"vite.config.ts",
				"tsconfig.json",
				"svelte.config.js",
				"package.json",
				"../tailwind-config/tailwind-config.css",
				"../tailwind-config/tailwind-config-dark.css"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"lint": {
			"command": "eslint . --concurrency auto",
			"files": [
				"**/*.{js,mjs,cjs,ts,svelte}",
				"!dist/**",
				"!.wireit/**",
				"eslint.config.js",
				"tsconfig.json",
				"package.json",
				"../tailwind-config/tailwind-config.css"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		},
		"format": {
			"command": "prettier --check .",
			"files": [
				"**",
				"!dist/**",
				"!.wireit/**"
			],
			"output": [],
			"packageLocks": [
				"pnpm-lock.yaml",
				"pnpm-workspace.yaml"
			]
		}
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-go": "^6.0.1",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/language": "^6.13.1",
		"@codemirror/merge": "^6.12.3",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"@viamrobotics/tailwind-config": "workspace:^"
	},
	"peerDependencies": {
		"svelte": "^5.29.0"
	},
	"devDependencies": {
		"@eslint/compat": "catalog:",
		"@eslint/js": "catalog:",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@vitest/browser-playwright": "^4.1.3",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "catalog:",
		"globals": "catalog:",
		"playwright": "^1.65.0",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"keywords": [
		"svelte",
		"codemirror",
		"code editor",
		"diff"
	]
}
