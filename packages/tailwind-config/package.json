{
  "name": "@viamrobotics/tailwind-config",
  "version": "1.2.0",
  "description": "Viam's shared Tailwind CSS v4 configuration.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamrobotics/prime.git",
    "directory": "packages/tailwind-config"
  },
  "keywords": [
    "tailwind",
    "tailwindcss"
  ],
  "type": "module",
  "exports": {
    ".": "./tailwind-config.css",
    "./dark": "./tailwind-config-dark.css",
    "./fonts": "./fonts.js"
  },
  "files": [
    "fonts.js",
    "tailwind-config.css",
    "tailwind-config-dark.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "prepare": "pnpm run sync || echo ''",
    "sync": "wireit",
    "build": "wireit",
    "check": "wireit",
    "lint": "wireit",
    "format": "prettier --write ."
  },
  "wireit": {
    "sync": {
      "command": "svelte-kit sync",
      "files": [
        "svelte.config.js",
        "tsconfig.json",
        "src/**",
        "package.json"
      ],
      "output": [
        ".svelte-kit/generated/**",
        ".svelte-kit/types/**",
        ".svelte-kit/ambient.d.ts",
        ".svelte-kit/non-ambient.d.ts",
        ".svelte-kit/tsconfig.json"
      ],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "build": {
      "command": "vite build",
      "dependencies": [
        "sync"
      ],
      "files": [
        "src/**",
        "tailwind-config.css",
        "tailwind-config-dark.css",
        "fonts.js",
        "vite.config.ts",
        "svelte.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "build/**",
        ".svelte-kit/output/**"
      ],
      "env": {
        "DOCS_BASE": {
          "external": true
        }
      },
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "check": {
      "command": "svelte-check --tsconfig ./tsconfig.json",
      "dependencies": [
        "sync"
      ],
      "files": [
        "src/**",
        "tsconfig.json",
        "svelte.config.js",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "lint": {
      "command": "eslint . --concurrency auto",
      "dependencies": [
        "sync"
      ],
      "files": [
        "**/*.{js,mjs,cjs,ts,svelte}",
        "!build/**",
        "!.svelte-kit/**",
        "!.wireit/**",
        "eslint.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    }
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "catalog:",
    "@fontsource-variable/roboto-mono": "catalog:",
    "@fontsource-variable/space-grotesk": "^5.2.10"
  },
  "peerDependencies": {
    "tailwindcss": ">=4 <5"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:",
    "@eslint/js": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "wireit": "catalog:"
  }
}
