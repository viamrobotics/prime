{
  "name": "@viamrobotics/tailwind-config",
  "version": "1.6.0",
  "description": "Viam's shared Tailwind CSS v4 configuration.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamrobotics/prime.git",
    "directory": "packages/tailwind-config"
  },
  "keywords": [
    "tailwind",
    "tailwindcss"
  ],
  "type": "module",
  "exports": {
    ".": "./tailwind-config.css",
    "./dark": "./tailwind-config-dark.css",
    "./fonts": "./fonts.js"
  },
  "files": [
    "fonts.js",
    "tailwind-config.css",
    "tailwind-config-dark.css"
  ],
  "scripts": {
    "check": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "test:unit": "vitest",
    "lint:fix": "eslint . --fix --concurrency auto",
    "format": "wireit",
    "format:fix": "prettier --write ."
  },
  "wireit": {
    "check": {
      "command": "tsc --noEmit -p tsconfig.json",
      "files": [
        "fonts.js",
        "tests/**",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "lint": {
      "command": "eslint . --concurrency auto",
      "files": [
        "**/*.{js,mjs,cjs,ts}",
        "!.wireit/**",
        "eslint.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "test": {
      "command": "vitest run",
      "files": [
        "tests/**",
        "tailwind-config.css",
        "tailwind-config-dark.css",
        "vitest.config.ts",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "format": {
      "command": "prettier --check .",
      "files": [
        "**",
        "!.wireit/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    }
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "catalog:",
    "@fontsource-variable/roboto-mono": "catalog:",
    "@fontsource-variable/space-grotesk": "^5.2.10"
  },
  "peerDependencies": {
    "tailwindcss": ">=4 <5"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:",
    "@eslint/js": "catalog:",
    "@tailwindcss/node": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "postcss": "^8.5.14",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "wireit": "catalog:"
  }
}
