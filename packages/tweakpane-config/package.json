{
  "name": "@viamrobotics/tweakpane-config",
  "version": "0.2.2",
  "description": "Viam-themed configuration for svelte-tweakpane-ui.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamrobotics/prime.git",
    "directory": "packages/tweakpane-config"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "wireit",
    "package": "wireit",
    "prepack": "wireit",
    "check": "wireit",
    "lint": "wireit",
    "lint:fix": "eslint . --fix --concurrency auto",
    "format": "wireit",
    "format:fix": "prettier --write ."
  },
  "wireit": {
    "build": {
      "dependencies": [
        "package"
      ]
    },
    "package": {
      "command": "tsc -p tsconfig.build.json && publint",
      "files": [
        "src/lib/**",
        "tsconfig.build.json",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**"
      ],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "prepack": {
      "dependencies": [
        "package"
      ]
    },
    "check": {
      "command": "tsc --noEmit -p tsconfig.json",
      "files": [
        "src/**",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "lint": {
      "command": "eslint . --concurrency auto",
      "files": [
        "**/*.{js,mjs,cjs,ts}",
        "!dist/**",
        "!.wireit/**",
        "eslint.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "format": {
      "command": "prettier --check .",
      "files": [
        "**",
        "!dist/**",
        "!.wireit/**"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "svelte-tweakpane-ui": "^1.5.16"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-tweakpane-ui": "^1.5.16",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "keywords": [
    "svelte",
    "tweakpane",
    "viam"
  ]
}
