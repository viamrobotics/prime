{
  "name": "@viamrobotics/tweakpane-config",
  "version": "0.2.2",
  "description": "Viam-themed configuration for svelte-tweakpane-ui.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viamrobotics/prime.git",
    "directory": "packages/tweakpane-config"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite dev",
    "preview": "vite preview",
    "prepare": "pnpm run sync || echo ''",
    "sync": "wireit",
    "build": "wireit",
    "vite-build": "wireit",
    "package": "wireit",
    "prepack": "wireit",
    "check": "wireit",
    "lint": "wireit",
    "format": "prettier --write ."
  },
  "wireit": {
    "sync": {
      "command": "svelte-kit sync",
      "files": [
        "svelte.config.js",
        "tsconfig.json",
        "src/**",
        "package.json"
      ],
      "output": [
        ".svelte-kit/generated/**",
        ".svelte-kit/types/**",
        ".svelte-kit/ambient.d.ts",
        ".svelte-kit/non-ambient.d.ts",
        ".svelte-kit/tsconfig.json"
      ],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "build": {
      "dependencies": [
        "package",
        "vite-build"
      ]
    },
    "package": {
      "command": "tsc -p tsconfig.build.json && publint",
      "files": [
        "src/lib/**",
        "tsconfig.build.json",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**"
      ],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "vite-build": {
      "command": "vite build",
      "dependencies": [
        "sync"
      ],
      "files": [
        "src/**",
        "vite.config.ts",
        "svelte.config.js",
        "tsconfig.json",
        "package.json",
        "../tailwind-config/tailwind-config.css",
        "../tailwind-config/tailwind-config-dark.css"
      ],
      "output": [
        "build/**",
        ".svelte-kit/output/**"
      ],
      "env": {
        "DOCS_BASE": {
          "external": true
        }
      },
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "prepack": {
      "dependencies": [
        "package"
      ]
    },
    "check": {
      "command": "svelte-check --tsconfig ./tsconfig.json",
      "dependencies": [
        "sync"
      ],
      "files": [
        "src/**",
        "tsconfig.json",
        "svelte.config.js",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    },
    "lint": {
      "command": "eslint . --concurrency auto",
      "dependencies": [
        "sync"
      ],
      "files": [
        "**/*.{js,mjs,cjs,ts,svelte}",
        "!build/**",
        "!dist/**",
        "!.svelte-kit/**",
        "!.wireit/**",
        "eslint.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "output": [],
      "packageLocks": [
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml"
      ]
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "svelte-tweakpane-ui": "^1.5.16"
  },
  "devDependencies": {
    "@eslint/compat": "catalog:",
    "@eslint/js": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@viamrobotics/tailwind-config": "workspace:^",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "svelte-tweakpane-ui": "^1.5.16",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:"
  },
  "keywords": [
    "svelte",
    "tweakpane",
    "viam"
  ]
}
